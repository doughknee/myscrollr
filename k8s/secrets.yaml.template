# ============================================================
# K8s Secrets — DO NOT COMMIT with real values.
# Copy to secrets.yaml, fill in base64-encoded values, apply.
#
#   echo -n "your-value" | base64
#   kubectl apply -f secrets.yaml
# ============================================================
apiVersion: v1
kind: Secret
metadata:
  name: scrollr-secrets
  namespace: scrollr
type: Opaque
data:
  # Shared infrastructure
  DATABASE_URL: ""          # postgresql://user:pass@host:25060/defaultdb?sslmode=require
  REDIS_URL: ""             # rediss://default:pass@host:25061
  ENCRYPTION_KEY: ""        # AES key for OAuth token encryption

  # Logto (auth)
  LOGTO_M2M_APP_ID: ""
  LOGTO_M2M_APP_SECRET: ""
  LOGTO_EXTENSION_APP_ID: ""
  LOGTO_WEB_APP_ID: ""

  # Stripe (billing)
  STRIPE_SECRET_KEY: ""
  STRIPE_PUBLISHABLE_KEY: ""
  STRIPE_WEBHOOK_SECRET: ""

  # Sequin (CDC)
  SEQUIN_WEBHOOK_SECRET: ""

  # External APIs
  TWELVEDATA_API_KEY: ""
  API_SPORTS_KEY: ""

  # Support (OS Ticket)
  OSTICKET_API_KEY: ""

  # Linear — three things use this one key: the "File as bug" button in the
  # Discord support queue creates issues with it, the release webhook asks it
  # whether the issue behind a case is Done yet, and AI triage reads the open
  # bugs so a draft can say "that one is known and being fixed" instead of
  # guessing. Personal API key from Linear → Settings → Security & access →
  # Personal API keys (starts `lin_api_`); it needs write access for the
  # button. Absent = the button reports it isn't configured and the triage
  # prompt says the tracker is unavailable. Nothing else changes.
  LINEAR_API_KEY: ""

  # Transactional email (Resend) — drives password-reset emails + invite scripts
  RESEND_API_KEY: ""
  RESEND_FROM_EMAIL: ""      # e.g. invites@myscrollr.com

  # Sentry — error monitoring (shared across all backend services).
  # Per-service DSNs are inlined directly in each Deployment manifest
  # (k8s/<service>.yaml) because DSNs are write-only ingestion endpoints,
  # not data-exfil credentials. Only the shared keys live here.
  #
  # SENTRY_USER_SALT: generate ONCE with `openssl rand -hex 32`. NEVER
  # rotate — rotating un-clusters every historical event because the
  # hashed user IDs become incompatible.
  SENTRY_USER_SALT: ""
  # Environment tag attached to every event. "production" or "staging".
  ENVIRONMENT: ""
  # Release tag — set by CI to the deployed git SHA. See
  # .github/workflows/deploy.yml for the kubectl set env wiring.
  GIT_SHA: ""

  # PostHog analytics. The project key is ingest-only; the personal key needs
  # only person deletion access. Generate the salt once and never rotate it.
  POSTHOG_PROJECT_KEY: ""
  POSTHOG_PERSONAL_API_KEY: ""
  POSTHOG_DISTINCT_ID_SALT: ""
  POSTHOG_EXCLUDED_LOGTO_SUBS: ""

  # Ops release page (SCROLLR-305, /ops/release?key=…). Unset key = no page.
  GITHUB_OPS_TOKEN: ""      # fine-grained PAT, this repo only, Actions: read+write
  OPS_RELEASE_KEY: ""       # long random string; the page's only auth

  # Connect GitHub — the Scrollr Desktop GitHub App (SCROLLR-304). Core
  # brokers its user-to-server OAuth (client id + secret) and stores the
  # tokens encrypted with ENCRYPTION_KEY. Absent = /github/connect answers
  # 503; public repos keep working through core's unauthenticated fallback.
  # GITHUB_APP_CALLBACK_URL is optional (defaults to
  # https://api.myscrollr.com/github/callback); set it on dev-api.
  GITHUB_APP_ID: ""
  GITHUB_APP_SLUG: ""
  GITHUB_APP_CLIENT_ID: ""
  GITHUB_APP_CLIENT_SECRET: ""
  GITHUB_APP_WEBHOOK_SECRET: ""
  GITHUB_APP_PRIVATE_KEY: ""
