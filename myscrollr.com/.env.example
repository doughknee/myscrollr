# Frontend Environment Variables
# Copy this to .env for local development

# API URL
VITE_API_URL=http://localhost:8080

# Logto authentication
# Production values:
# VITE_LOGTO_ENDPOINT=https://auth.myscrollr.com
# VITE_LOGTO_APP_ID=your_production_logto_app_id
# VITE_LOGTO_RESOURCE=https://api.myscrollr.com
VITE_LOGTO_ENDPOINT=your_local_or_dev_logto_endpoint
VITE_LOGTO_APP_ID=your_local_or_dev_logto_app_id
VITE_LOGTO_RESOURCE=http://localhost:8080

# Stripe (publishable key only — never put secret key here)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME

# Uplink (base paid tier) price IDs
VITE_STRIPE_PRICE_MONTHLY=price_1TMyBUFk6czwHVgrocQKaBHD
VITE_STRIPE_PRICE_ANNUAL=price_1TMyBUFk6czwHVgr2AysFrfL

# Uplink Pro (mid-tier) price IDs
VITE_STRIPE_PRICE_PRO_MONTHLY=price_1TMyBUFk6czwHVgrc6YHoQoj
VITE_STRIPE_PRICE_PRO_ANNUAL=price_1TMyBVFk6czwHVgrN2oUq6fx

# Uplink Ultimate (top-tier) price IDs
VITE_STRIPE_PRICE_ULTIMATE_MONTHLY=price_1TMyBVFk6czwHVgriAztoY86
VITE_STRIPE_PRICE_ULTIMATE_ANNUAL=price_1TMyBVFk6czwHVgr9ntOrMXf

# Sentry — error monitoring (scrollr-web project)
# DSN is safe to expose client-side (Sentry's design).
VITE_SENTRY_DSN=

# Optional PostHog website analytics. Production events use the same-origin
# /ingest proxy and remain subject to regional policy and visitor choices.
VITE_POSTHOG_KEY=

# CI-only — used by @sentry/vite-plugin for source map upload.
# NEVER commit a real value. Leave empty for local builds.
SENTRY_ORG=
SENTRY_AUTH_TOKEN=
