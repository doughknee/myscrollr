# Core API — local development.
#
# `make setup` generates this file for you; copy it by hand only if you're
# not using the Makefile. Values marked GENERATED are filled in
# automatically; values marked ASK are prompted for once.
#
# The API reads ~65 env vars in total. The other ~49 drive production-only
# integrations (Stripe billing, Discord triage, osTicket, Anthropic, Sentry,
# GitHub webhooks) and every one of them degrades gracefully when unset —
# the service logs that the integration is off and keeps serving. Do not
# copy the production set down; you do not need it.

# ── Infrastructure (GENERATED — matches docker/compose.yml) ──────────
# Inside Docker these are overridden to reach containers by service name;
# the values here are what a host-side process would use.
DATABASE_URL=postgres://scrollr:scrollr@localhost:5432/scrollr?sslmode=disable
REDIS_URL=redis://localhost:6379
PORT=8080

# ── URLs (GENERATED) ─────────────────────────────────────────────────
# Core is published on 18080, not 8080 — Steam's CEF debugger claims
# localhost:8080 on Windows. Containers still talk to it on 8080 in-network.
API_URL=http://localhost:18080
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5174,tauri://localhost

# ── Local posture (GENERATED) ────────────────────────────────────────
ENVIRONMENT=development
# Billing off locally: no Stripe keys, no webhook endpoint, no test charges.
STRIPE_DISABLED=true

# ── Encryption (GENERATED) ───────────────────────────────────────────
# Encrypts stored third-party tokens. Must be IDENTICAL to the
# ENCRYPTION_KEY in channels/*/.env or those services cannot read what
# core wrote. `make setup` generates one value and writes it everywhere.
ENCRYPTION_KEY=

# ── Auth: Logto (ASK — the only values you must supply) ──────────────
# Local dev points at the SHARED Logto tenant; there is no local Logto.
# Get these from the Logto admin console, or from the GitHub secrets of the
# same name. None is secret — they are public client identifiers and role
# ids — but they are environment-specific, so they can't be defaulted.
LOGTO_URL=
LOGTO_JWKS_URL=
LOGTO_EXTENSION_APP_ID=
LOGTO_WEB_APP_ID=

# Role ids map a Logto role onto a subscription tier. Without them every
# signed-in user resolves to the free tier locally, which is a fine way to
# start — fill them in when you need to exercise paid-tier behaviour.
LOGTO_UPLINK_ROLE_ID=
LOGTO_PRO_ROLE_ID=
LOGTO_ULTIMATE_ROLE_ID=
LOGTO_SUPER_USER_ROLE_ID=

# ── Widget sources (set by docker/compose.yml, not here) ─────────────
# INTERNAL_{FINANCE,SPORTS,RSS}_URL point core at the Rust ingesters.
# Compose sets them to the container names; unset means core reports
# that source healthy without probing it.
# PostHog stays inert unless every server setting is present and capture is explicitly enabled.
POSTHOG_CAPTURE_ENABLED=false
POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_API_HOST=https://us.posthog.com
POSTHOG_PROJECT_KEY=
POSTHOG_PROJECT_ID=
POSTHOG_PERSONAL_API_KEY=
POSTHOG_DISTINCT_ID_SALT=
POSTHOG_EXCLUDED_LOGTO_SUBS=

# Ops release page (SCROLLR-305): /ops/release?key=OPS_RELEASE_KEY dispatches
# finish-release.yml with GITHUB_OPS_TOKEN. Unset key = no page.
GITHUB_OPS_TOKEN=
OPS_RELEASE_KEY=
OPS_RELEASE_TAG=desktop-v1.7.0

# ── Connect GitHub: the Scrollr Desktop GitHub App (SCROLLR-304) ─────
# Unset = /github/connect answers 503 and the widget keeps serving public
# repos through core's unauthenticated fallback. Values live in
# scrollr-secrets; never commit them. Only the client id and secret are
# used today (user-to-server OAuth); the rest are recorded for the app.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_APP_PRIVATE_KEY=
# Must be one of the app's registered callback URLs. Defaults to
# production; locally use http://localhost:18080/github/callback.
GITHUB_APP_CALLBACK_URL=
